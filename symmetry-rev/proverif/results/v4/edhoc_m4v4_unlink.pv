(* superseded by edhoc_m4v4_unlink_bounded.pv (allocation failure, see SUMMARY_v4.txt) *)
(* =====================================================================
 * edhoc_m4v4_unlink.pv
 * Variant : EAP-EDHOC hybrid PQC method 4, v4 (X-Wing = ML-KEM-768 + X25519, ML-DSA-44 detached-signature
 *           gate), no ephemeral X-Wing; next one-time keys in EAD_1 (Npk_A) and EAD_2 (Npk_B);
 *           EAD_2 under MAC_2/sigma_R; PT3 = (MAC_3, VK_I, sigma_I); Message4 = AEAD(K_4, empty);
 *           KeyID_B = H(pk_B) in clear, AAD_1 = (KeyID_B, ct_B), TH_1 = H(pk_B, ct_B), DN-AAA
 *           record found by KeyID_B (table recs)
 * Setting : unlinkability between successful runs (diff-equivalence, choice[]): left = two consecutive
 *           runs of the SAME UE (second run on the keys rotated in the first), right = a
 *           run of UE1 followed by a run of ANOTHER UE; anonymous outer identity; DN-AAA
 *           record found by KeyID_B
 * Model   : symbolic (Dolev-Yao), ProVerif 2.05. X-Wing uses the same compact
 *           abstraction as edhoc_m4_hybrid_*.pv (no DH equational theory).
 * Part of : EdhocSecondaryAuth -- ProVerif models for
 *           "Role-Symmetric EAP-EDHOC with Hybrid Post-Quantum Cryptography
 *            for 5G Secondary Authentication and Application-Server Access"
 * Expected: observational equivalence (left ~ right) proved, or not provable (report as is)
 * Generated by gen_m4v4.py.
 * ===================================================================== *)

(* ---------------- Channel, types ---------------- *)
free c : channel.

type exponent.          (* X25519 scalar                              *)
type kemsk.             (* ML-KEM-768 decapsulation key               *)
type xpk.               (* X-Wing public key (ML-KEM-768 ek, X25519)  *)
type edsk.              (* Ed25519 signing key                        *)
type edpk.              (* Ed25519 verification key                   *)
type mdsk.              (* ML-DSA-44 signing key                      *)
type mdpk.              (* ML-DSA-44 verification key                 *)

(* ---------------- X-Wing hybrid KEM (ML-KEM-768 + X25519, SHA3 combiner) ----------------
 * Modelled as compact terms, like edhoc_m4_hybrid_base.pv, but keeping the two
 * halves visible. (Spelling X25519 out with a DH equational theory and the
 * 5-input combiner hash made the transcript terms grow exponentially, and
 * ProVerif ran out of memory.)
 * A static or ephemeral key pair is (k, x): k = ML-KEM-768 decapsulation key,
 * x = X25519 scalar, pk = xwpk(k, x). Encapsulation draws ML-KEM coins s and an
 * X25519 ephemeral scalar e: ct = xw_ct(pk, s, e), ss = xw_ss(pk, s, e).
 * xw_ss is public: whoever knows the coins (the encapsulator, honest or not)
 * knows ss. Since ss binds pk and both coins, it also binds (ct_M, ct_X, pk_X)
 * as the X-Wing combiner does. *)
fun xwpk(kemsk, exponent) : xpk.
fun xw_ct(xpk, bitstring, exponent) : bitstring.
fun xw_ss(xpk, bitstring, exponent) : bitstring.
fun xpk2b(xpk) : bitstring [data, typeConverter].
(* Honest decapsulation uses both secret halves. *)
reduc forall k:kemsk, x:exponent, s:bitstring, e:exponent;
  xw_decaps(k, x, xw_ct(xwpk(k, x), s, e)) = xw_ss(xwpk(k, x), s, e).
(* Each secret half alone opens only its own component of ct: k yields the
 * ML-KEM shared secret (stand-in: s); x yields the X25519 shared secret
 * (stand-in: e, which is used nowhere else). ss needs both, so the hybrid
 * secret stays safe as long as one half does. *)
reduc forall k:kemsk, x:exponent, s:bitstring, e:exponent;
  mlkem_dec(k, xw_ct(xwpk(k, x), s, e)) = s.
reduc forall k:kemsk, x:exponent, s:bitstring, e:exponent;
  x25519_dec(x, xw_ct(xwpk(k, x), s, e)) = e.

(* ---------------- Ed25519 (EUF-CMA, classical) ---------------- *)
fun edpub(edsk) : edpk.
fun edsign(bitstring, edsk) : bitstring.
reduc forall m:bitstring, k:edsk; edverify(edpub(k), edsign(m, k)) = m.

(* ---------------- ML-DSA-44 (EUF-CMA, post-quantum) ---------------- *)
fun mdpub(mdsk) : mdpk.
fun mdsign(bitstring, mdsk) : bitstring.
reduc forall m:bitstring, k:mdsk; mdverify(mdpub(k), mdsign(m, k)) = m.

(* ---------------- Hash, HKDF, AEAD ---------------- *)
fun H(bitstring) : bitstring.
fun extract(bitstring, bitstring) : bitstring.      (* HKDF-Extract(salt, ikm) *)
fun expands(bitstring, bitstring) : bitstring.      (* HKDF-Expand(prk, info)  *)
fun AEAD_enc(bitstring, bitstring) : bitstring.
reduc forall k:bitstring, m:bitstring; AEAD_dec(k, AEAD_enc(k, m)) = m.
fun AEAD_enc_aad(bitstring, bitstring, bitstring) : bitstring.
reduc forall k:bitstring, a:bitstring, m:bitstring;
  AEAD_dec_aad(k, a, AEAD_enc_aad(k, a, m)) = m.

(* ---------------- Quantum oracle (used only in *_quantum.pv) ----------------
 * A quantum adversary solves discrete logarithms (Shor) and therefore
 * recovers the X25519 scalar of any X-Wing public key, the X25519 ephemeral
 * of any X-Wing ciphertext, and Ed25519 signing keys.
 * No oracle exists for ML-KEM-768 or ML-DSA-44. *)
reduc forall k:kemsk, x:exponent; q_xpk(xwpk(k, x)) = x [private].
reduc forall p:xpk, s:bitstring, e:exponent; q_xct(xw_ct(p, s, e)) = e [private].
reduc forall k:edsk; qed(edpub(k)) = k [private].

(* ---------------- Constants ---------------- *)
const W0, W1, W2 : bitstring.             (* world / epoch tags *)
const SuitesI, CI, CR, EAD4empty, Len2, Len3, commit : bitstring.
const M_0, M_1, M_2, M_3, M_4 : bitstring.
const lbl_K2, lbl_K3, lbl_K4, lbl_MAC2, lbl_MAC3, lbl_out, lbl_MSK, lbl_EMSK : bitstring.
const lbl_xw, lbl_hyb, lbl_shs, lbl_chs, lbl_scv, lbl_ccv, lbl_sfin, lbl_cfin, lbl_ms, lbl_sapp : bitstring.

(* ---------------- Secrets under test ---------------- *)
free ID_CREDI : bitstring [private].
free ID_CREDR : bitstring [private].
free ID_CREDI2 : bitstring [private].
free app_data_UE, app_data_DN : bitstring [private].
free MSK_test, EMSK_test, MSK_test2, EMSK_test2 : bitstring [private].

(* ---------------- Events (first argument = world/epoch tag) ---------------- *)
event UE_send_M1(bitstring, bitstring).
event DN_send_M2(bitstring, bitstring, bitstring, bitstring, bitstring).
event UE_recv_M2(bitstring, bitstring, bitstring, bitstring, bitstring).
event UE_send_M3(bitstring, bitstring, bitstring, bitstring, bitstring).
event DN_recv_M3(bitstring, bitstring, bitstring, bitstring, bitstring).
event DN_send_M4(bitstring, bitstring, bitstring, bitstring, bitstring).
event UE_recv_M4(bitstring, bitstring, bitstring, bitstring, bitstring).
event UE_finish(bitstring, bitstring, bitstring).
event DN_finish(bitstring, bitstring, bitstring).

table urecs(bitstring, kemsk, exponent, xpk, mdpk, bitstring).

let QXW = (! in(c, p:xpk); out(c, q_xpk(p))) | (! in(c, ct:bitstring); out(c, q_xct(ct))).
let QED = ! in(c, p:edpk); out(c, qed(p)).


(* ============================ PROCESSES ========================== *)
let DN(skSigR:mdsk, pkSigR:mdpk) =
  in(c, Message1:bitstring);
  let (kidB:bitstring, ctB:bitstring, encP1:bitstring) = Message1 in
  get urecs(=kidB, B_pq:kemsk, B_x:exponent, pkA:xpk, pkSigI:mdpk, idc:bitstring) in
  let pkB = xwpk(B_pq, B_x) in
  if kidB = H(xpk2b(pkB)) then
  let ssB = xw_decaps(B_pq, B_x, ctB) in
  let TH1 = H((xpk2b(pkB), ctB)) in
  let K1 = expands(extract(TH1, ssB), TH1) in
  let (=M_4, =SuitesI, =idc, =CI, EAD1:bitstring) = AEAD_dec_aad(K1, (kidB, ctB), encP1) in
  let xpk2b(NpkA:xpk) = EAD1 in
  new NB_pq:kemsk; new NB_x:exponent;
  let EAD2 = xpk2b(xwpk(NB_pq, NB_x)) in
  new sA:bitstring; new eA:exponent;
  let ctA = xw_ct(pkA, sA, eA) in
  let ssA = xw_ss(pkA, sA, eA) in
  let TH2 = H((H(Message1), ctA, CR)) in
  let PRK2e = extract(TH2, ssA) in
  let PRK3e2m = extract(PRK2e, ssB) in
  let MAC2 = expands(PRK3e2m, (lbl_MAC2, TH2, ID_CREDR, EAD2, Len2)) in
  let PT2 = (CR, ID_CREDR, pkSigR, EAD2, MAC2, mdsign((TH2, ID_CREDR, MAC2), skSigR)) in
  let TH3 = H((TH2, PT2)) in
  out(c, (ctA, AEAD_enc(expands(PRK2e, (lbl_K2, TH2)), PT2)));
  in(c, Message3:bitstring);
  let PT3 = AEAD_dec(expands(PRK3e2m, (lbl_K3, TH3)), Message3) in
  let (MAC3r:bitstring, =pkSigI, sigIr:bitstring) = PT3 in
  if MAC3r = expands(PRK3e2m, (lbl_MAC3, TH3, idc, Len3)) then
  if mdverify(pkSigI, sigIr) = (TH3, idc, MAC3r) then
  (* commit: record of the next key, found by H(Npk_B) *)
  insert urecs(H(EAD2), NB_pq, NB_x, NpkA, pkSigI, idc);
  out(c, AEAD_enc(expands(PRK3e2m, (lbl_K4, H((TH3, PT3)))), EAD4empty)).

(* ============================== MAIN ============================= *)
process
  new skSigR:mdsk; let pkSigR = mdpub(skSigR) in out(c, pkSigR);
  new skSigI1:mdsk; new skSigI2:mdsk;
  let pkSigI1 = mdpub(skSigI1) in let pkSigI2 = mdpub(skSigI2) in
  new A1_pq:kemsk; new A1_x:exponent; new B1_pq:kemsk; new B1_x:exponent;
  new A2_pq:kemsk; new A2_x:exponent; new B2_pq:kemsk; new B2_x:exponent;
  let pkA1 = xwpk(A1_pq, A1_x) in let pkB1 = xwpk(B1_pq, B1_x) in
  let pkA2 = xwpk(A2_pq, A2_x) in let pkB2 = xwpk(B2_pq, B2_x) in
  (* provisioned records: UE1, and UE2 (used only on the right) *)
  insert urecs(H(xpk2b(pkB1)), B1_pq, B1_x, pkA1, pkSigI1, ID_CREDI);
  insert urecs(H(xpk2b(pkB2)), B2_pq, B2_x, pkA2, pkSigI2, ID_CREDI2);
  (
    ( (* run 1: UE1; run 2: left = UE1 on its rotated keys, right = UE2 *)
  new NA_pq1:kemsk; new NA_x1:exponent;
  let EAD11 = xpk2b(xwpk(NA_pq1, NA_x1)) in
  let kidB1 = H(xpk2b(pkB1)) in
  new sB1:bitstring; new eB1:exponent;
  let ctB1 = xw_ct(pkB1, sB1, eB1) in
  let ssB1 = xw_ss(pkB1, sB1, eB1) in
  let PT11 = (M_4, SuitesI, ID_CREDI, CI, EAD11) in
  let TH11 = H((xpk2b(pkB1), ctB1)) in
  let K11 = expands(extract(TH11, ssB1), TH11) in
  let Message11 = (kidB1, ctB1, AEAD_enc_aad(K11, (kidB1, ctB1), PT11)) in
  out(c, Message11);
  in(c, (ctA1:bitstring, encP21:bitstring));
  let ssA1 = xw_decaps(A1_pq, A1_x, ctA1) in
  let TH21 = H((H(Message11), ctA1, CR)) in
  let PRK2e1 = extract(TH21, ssA1) in
  let K21 = expands(PRK2e1, (lbl_K2, TH21)) in
  let PT21 = AEAD_dec(K21, encP21) in
  let (=CR, =ID_CREDR, =pkSigR, EAD21:bitstring, MAC21:bitstring, sigR1:bitstring) = PT21 in
  let xpk2b(NpkB1:xpk) = EAD21 in
  let PRK3e2m1 = extract(PRK2e1, ssB1) in
  if MAC21 = expands(PRK3e2m1, (lbl_MAC2, TH21, ID_CREDR, EAD21, Len2)) then
  if mdverify(pkSigR, sigR1) = (TH21, ID_CREDR, MAC21) then
  let TH31 = H((TH21, PT21)) in
  let MAC31 = expands(PRK3e2m1, (lbl_MAC3, TH31, ID_CREDI, Len3)) in
  let sigI1 = mdsign((TH31, ID_CREDI, MAC31), skSigI1) in
  let K31 = expands(PRK3e2m1, (lbl_K3, TH31)) in
  let PT31 = (MAC31, pkSigI1, sigI1) in
  out(c, AEAD_enc(K31, PT31));
  in(c, Message41:bitstring);
  let TH41 = H((TH31, PT31)) in
  if AEAD_dec(expands(PRK3e2m1, (lbl_K4, TH41)), Message41) = EAD4empty then
  new NA_pq2:kemsk; new NA_x2:exponent;
  let EAD12 = xpk2b(xwpk(NA_pq2, NA_x2)) in
  let kidB2 = H(xpk2b(choice[NpkB1, pkB2])) in
  new sB2:bitstring; new eB2:exponent;
  let ctB2 = xw_ct(choice[NpkB1, pkB2], sB2, eB2) in
  let ssB2 = xw_ss(choice[NpkB1, pkB2], sB2, eB2) in
  let PT12 = (M_4, SuitesI, choice[ID_CREDI, ID_CREDI2], CI, EAD12) in
  let TH12 = H((xpk2b(choice[NpkB1, pkB2]), ctB2)) in
  let K12 = expands(extract(TH12, ssB2), TH12) in
  let Message12 = (kidB2, ctB2, AEAD_enc_aad(K12, (kidB2, ctB2), PT12)) in
  out(c, Message12);
  in(c, (ctA2:bitstring, encP22:bitstring));
  let ssA2 = xw_decaps(choice[NA_pq1, A2_pq], choice[NA_x1, A2_x], ctA2) in
  let TH22 = H((H(Message12), ctA2, CR)) in
  let PRK2e2 = extract(TH22, ssA2) in
  let K22 = expands(PRK2e2, (lbl_K2, TH22)) in
  let PT22 = AEAD_dec(K22, encP22) in
  let (=CR, =ID_CREDR, =pkSigR, EAD22:bitstring, MAC22:bitstring, sigR2:bitstring) = PT22 in
  let xpk2b(NpkB2:xpk) = EAD22 in
  let PRK3e2m2 = extract(PRK2e2, ssB2) in
  if MAC22 = expands(PRK3e2m2, (lbl_MAC2, TH22, ID_CREDR, EAD22, Len2)) then
  if mdverify(pkSigR, sigR2) = (TH22, ID_CREDR, MAC22) then
  let TH32 = H((TH22, PT22)) in
  let MAC32 = expands(PRK3e2m2, (lbl_MAC3, TH32, choice[ID_CREDI, ID_CREDI2], Len3)) in
  let sigI2 = mdsign((TH32, choice[ID_CREDI, ID_CREDI2], MAC32), choice[skSigI1, skSigI2]) in
  let K32 = expands(PRK3e2m2, (lbl_K3, TH32)) in
  let PT32 = (MAC32, choice[pkSigI1, pkSigI2], sigI2) in
  out(c, AEAD_enc(K32, PT32));
  in(c, Message42:bitstring);
  let TH42 = H((TH32, PT32)) in
  if AEAD_dec(expands(PRK3e2m2, (lbl_K4, TH42)), Message42) = EAD4empty then
  0
    )
    | ( ! DN(skSigR, pkSigR) )
  )
