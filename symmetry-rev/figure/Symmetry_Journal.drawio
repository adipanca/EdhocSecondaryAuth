        <mxCell id="v4-7Pt2ibclDifcsB5aAMtm-32" parent="v4-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;3&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;3e2m&lt;/sub&gt;, TH&lt;sub&gt;3&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(MAC&lt;sub&gt;3&lt;/sub&gt;, VK&lt;sub&gt;I&lt;/sub&gt;, σ&lt;sub&gt;I&lt;/sub&gt;) = AEAD.Dec(K&lt;sub&gt;3&lt;/sub&gt;, Message3)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;4&lt;/sub&gt; = H(TH&lt;sub&gt;3&lt;/sub&gt;, Plaintext3)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;4e3m&lt;/sub&gt; = PRK&lt;sub&gt;3e2m&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MAC&lt;sub&gt;3&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;4e3m&lt;/sub&gt;, TH&lt;sub&gt;3&lt;/sub&gt;, ID_CRED&lt;sub&gt;I&lt;/sub&gt;, Len&lt;sub&gt;3&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ML-DSA.Verify(VK&lt;sub&gt;I&lt;/sub&gt;, TH&lt;sub&gt;3&lt;/sub&gt; ‖ ID_CRED&lt;sub&gt;I&lt;/sub&gt; ‖ MAC&lt;sub&gt;3&lt;/sub&gt;, σ&lt;sub&gt;I&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;out&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;4e3m&lt;/sub&gt;, TH&lt;sub&gt;4&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;AK = HKDF-Expand(PRK&lt;sub&gt;out&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Update&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;pk&lt;sub&gt;A&lt;/sub&gt; = EAD&lt;sub&gt;1&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Update&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(pk&lt;sub&gt;B&lt;/sub&gt;, sk&lt;sub&gt;B&lt;/sub&gt;) = (Npk&lt;sub&gt;B&lt;/sub&gt;, Nsk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Update&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Lookup index: KeyID&lt;sub&gt;B&lt;/sub&gt; = H(Npk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Erase&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;old sk&lt;sub&gt;B&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Plaintext4 = EAD&lt;sub&gt;4&lt;/sub&gt; (empty)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;4&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;4e3m&lt;/sub&gt;, TH&lt;sub&gt;4&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message4 = AEAD.Enc(K&lt;sub&gt;4&lt;/sub&gt;, Plaintext4)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MSK = EDHOC_Exporter(PRK&lt;sub&gt;out&lt;/sub&gt;, &quot;MSK&quot;, 64)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;EMSK = EDHOC_Exporter(PRK&lt;sub&gt;out&lt;/sub&gt;, &quot;EMSK&quot;, 64)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
