        <mxCell id="rv-7Pt2ibclDifcsB5aAMtm-38" parent="rv-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;4&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;4e3m&lt;/sub&gt;, TH&lt;sub&gt;4&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(EAD&lt;sub&gt;4&lt;/sub&gt;) = AEAD.Dec(K&lt;sub&gt;4&lt;/sub&gt;, Message4)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Update&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;pk&lt;sub&gt;B&lt;/sub&gt; = EAD&lt;sub&gt;4&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Update&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(pk&lt;sub&gt;A&lt;/sub&gt;, sk&lt;sub&gt;A&lt;/sub&gt;) = (Npk&lt;sub&gt;A&lt;/sub&gt;, Nsk&lt;sub&gt;A&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;&lt;font color=&quot;#009900&quot;&gt;Erase&lt;/font&gt;&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font color=&quot;#009900&quot;&gt;old sk&lt;sub&gt;A&lt;/sub&gt;   (forward secrecy)&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;out&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;4e3m&lt;/sub&gt;, TH&lt;sub&gt;4&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;AK = HKDF-Expand(PRK&lt;sub&gt;out&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MSK = EDHOC_Exporter(PRK&lt;sub&gt;out&lt;/sub&gt;, &quot;MSK&quot;, 64)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;EMSK = EDHOC_Exporter(PRK&lt;sub&gt;out&lt;/sub&gt;, &quot;EMSK&quot;, 64)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
