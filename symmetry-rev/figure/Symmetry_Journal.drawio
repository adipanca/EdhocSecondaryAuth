        <mxCell id="rv-7Pt2ibclDifcsB5aAMtm-17" parent="rv-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;Generate&lt;/font&gt;&lt;/strike&gt;&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;(sk&lt;sub&gt;X&lt;/sub&gt;, pk&lt;sub&gt;X&lt;/sub&gt;) = X-WING.KeyGen()&lt;/font&gt;&lt;/strike&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(ss&lt;sub&gt;B&lt;/sub&gt;, ct&lt;sub&gt;B&lt;/sub&gt;) = X-WING.Encaps(pk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Plaintext1 = (Method, Suites&lt;sub&gt;I&lt;/sub&gt;, ID_CRED&lt;sub&gt;I&lt;/sub&gt;, C&lt;sub&gt;I&lt;/sub&gt;, EAD&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;1&lt;/sub&gt; = H(&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;pk&lt;sub&gt;X&lt;/sub&gt;, &lt;/font&gt;&lt;/strike&gt;ct&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;1e&lt;/sub&gt; = HKDF-Extract(TH&lt;sub&gt;1&lt;/sub&gt;, ss&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;1&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;1e&lt;/sub&gt;, TH&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message1 = (ct&lt;sub&gt;B&lt;/sub&gt;, &lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;pk&lt;sub&gt;X&lt;/sub&gt;, &lt;/font&gt;&lt;/strike&gt;AEAD.Enc(K&lt;sub&gt;1&lt;/sub&gt;, Plaintext1))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="720" width="1900" x="-1156.5" y="-1825" as="geometry" />
        </mxCell>
        <mxCell id="JdljC3vooVqLY5zS2Q0n-1" edge="1" parent="rv-7Pt2ibclDifcsB5aAMtm-1" style="endArrow=none;dashed=1;html=1;rounded=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=20;strokeWidth=4;" target="rv-7Pt2ibclDifcsB5aAMtm-22" value="">
