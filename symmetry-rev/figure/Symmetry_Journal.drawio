        <mxCell id="rv-7Pt2ibclDifcsB5aAMtm-22" parent="rv-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(ct&lt;sub&gt;B&lt;/sub&gt;, &lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;pk&lt;sub&gt;X&lt;/sub&gt;, &lt;/font&gt;&lt;/strike&gt;Ciphertext1) = Message1&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ss&lt;sub&gt;B&lt;/sub&gt; = X-WING.Decaps(ct&lt;sub&gt;B&lt;/sub&gt;, sk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;1&lt;/sub&gt; = H(&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;pk&lt;sub&gt;X&lt;/sub&gt;, &lt;/font&gt;&lt;/strike&gt;ct&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;1e&lt;/sub&gt; = HKDF-Extract(TH&lt;sub&gt;1&lt;/sub&gt;, ss&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;1&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;1e&lt;/sub&gt;, TH&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(Method, Suites&lt;sub&gt;I&lt;/sub&gt;, ID_CRED&lt;sub&gt;I&lt;/sub&gt;, C&lt;sub&gt;I&lt;/sub&gt;, EAD&lt;sub&gt;1&lt;/sub&gt;) = AEAD.Dec(K&lt;sub&gt;1&lt;/sub&gt;, Ciphertext1)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;&lt;font color=&quot;#009900&quot;&gt;Set&lt;/font&gt;&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font color=&quot;#009900&quot;&gt;(pk&lt;sub&gt;A&lt;/sub&gt;, VK&lt;sub&gt;I&lt;/sub&gt;) = Lookup(ID_CRED&lt;sub&gt;I&lt;/sub&gt;)&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;Compute&lt;/font&gt;&lt;/strike&gt;&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;(ss&lt;sub&gt;e&lt;/sub&gt;, ct&lt;sub&gt;e&lt;/sub&gt;) = X-WING.Encaps(pk&lt;sub&gt;X&lt;/sub&gt;)&lt;/font&gt;&lt;/strike&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;&lt;font color=&quot;#009900&quot;&gt;Compute&lt;/font&gt;&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font color=&quot;#009900&quot;&gt;(ss&lt;sub&gt;A&lt;/sub&gt;, ct&lt;sub&gt;A&lt;/sub&gt;) = X-WING.Encaps(pk&lt;sub&gt;A&lt;/sub&gt;)   (moved up)&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;2&lt;/sub&gt; = H(H(Message1), &lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;ct&lt;sub&gt;e&lt;/sub&gt;&lt;/font&gt;&lt;/strike&gt;&lt;font color=&quot;#009900&quot;&gt;ct&lt;sub&gt;A&lt;/sub&gt;&lt;/font&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;2e&lt;/sub&gt; = HKDF-Extract(TH&lt;sub&gt;2&lt;/sub&gt;, &lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;ss&lt;sub&gt;e&lt;/sub&gt;&lt;/font&gt;&lt;/strike&gt;&lt;font color=&quot;#009900&quot;&gt;ss&lt;sub&gt;A&lt;/sub&gt;&lt;/font&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;2&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;2e&lt;/sub&gt;, TH&lt;sub&gt;2&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;3e2m&lt;/sub&gt; = HKDF-Extract(PRK&lt;sub&gt;2e&lt;/sub&gt;, ss&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MAC&lt;sub&gt;2&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;3e2m&lt;/sub&gt;, TH&lt;sub&gt;2&lt;/sub&gt;, ID_CRED&lt;sub&gt;R&lt;/sub&gt;, EAD&lt;sub&gt;2&lt;/sub&gt;, Len&lt;sub&gt;2&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Sign&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;σ&lt;sub&gt;R&lt;/sub&gt; = ML-DSA.Sign(sk&lt;sub&gt;SIG,R&lt;/sub&gt;, TH&lt;sub&gt;2&lt;/sub&gt; ‖ ID_CRED&lt;sub&gt;R&lt;/sub&gt; ‖ MAC&lt;sub&gt;2&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Plaintext2 = (&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;ct&lt;sub&gt;A&lt;/sub&gt;, &lt;/font&gt;&lt;/strike&gt;C&lt;sub&gt;R&lt;/sub&gt;, ID_CRED&lt;sub&gt;R&lt;/sub&gt;, VK&lt;sub&gt;R&lt;/sub&gt;, EAD&lt;sub&gt;2&lt;/sub&gt;, MAC&lt;sub&gt;2&lt;/sub&gt;, σ&lt;sub&gt;R&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message2 = (&lt;strike&gt;&lt;font color=&quot;#CC0000&quot;&gt;ct&lt;sub&gt;e&lt;/sub&gt;&lt;/font&gt;&lt;/strike&gt;&lt;font color=&quot;#009900&quot;&gt;ct&lt;sub&gt;A&lt;/sub&gt;&lt;/font&gt;, AEAD.Enc(K&lt;sub&gt;2&lt;/sub&gt;, Plaintext2))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;3&lt;/sub&gt; = H(TH&lt;sub&gt;2&lt;/sub&gt;, Plaintext2)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
