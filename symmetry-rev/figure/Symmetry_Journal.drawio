        <mxCell id="v4-7Pt2ibclDifcsB5aAMtm-17" parent="v4-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Generate&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(Nsk&lt;sub&gt;A&lt;/sub&gt;, Npk&lt;sub&gt;A&lt;/sub&gt;) = X-WING.KeyGen()&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;EAD&lt;sub&gt;1&lt;/sub&gt; = Npk&lt;sub&gt;A&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(ss&lt;sub&gt;B&lt;/sub&gt;, ct&lt;sub&gt;B&lt;/sub&gt;) = X-WING.Encaps(pk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;KeyID&lt;sub&gt;B&lt;/sub&gt; = H(pk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Plaintext1 = (Method, Suites&lt;sub&gt;I&lt;/sub&gt;, ID_CRED&lt;sub&gt;I&lt;/sub&gt;, C&lt;sub&gt;I&lt;/sub&gt;, EAD&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;1&lt;/sub&gt; = H(pk&lt;sub&gt;B&lt;/sub&gt;, ct&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;1e&lt;/sub&gt; = HKDF-Extract(TH&lt;sub&gt;1&lt;/sub&gt;, ss&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;1&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;1e&lt;/sub&gt;, TH&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;AAD&lt;sub&gt;1&lt;/sub&gt; = Encode(KeyID&lt;sub&gt;B&lt;/sub&gt;, ct&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message1 = (KeyID&lt;sub&gt;B&lt;/sub&gt;, ct&lt;sub&gt;B&lt;/sub&gt;, AEAD.Enc(K&lt;sub&gt;1&lt;/sub&gt;, AAD&lt;sub&gt;1&lt;/sub&gt;, Plaintext1))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1130.0" width="2286.9" x="-1156.5" y="-1825" as="geometry" />
        </mxCell>
      <mxCell id="v4-note" parent="v4-7Pt2ibclDifcsB5aAMtm-1" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;font style=&quot;font-size: 60px;&quot;&gt;Outer EAP-Response/Identity: anonymous NAI (@realm). The DN-AAA selects the record by KeyID&lt;sub&gt;B&lt;/sub&gt; = H(pk&lt;sub&gt;B&lt;/sub&gt;), sent in clear and bound as AEAD AAD; pk&lt;sub&gt;B&lt;/sub&gt; is one-time, so KeyID&lt;sub&gt;B&lt;/sub&gt; changes every run.&lt;/font&gt;"><mxGeometry x="-1150" y="-2560" width="4800" height="200" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
