        <mxCell id="rv-z8yuo7Fk02-dqpElgXCn-2" parent="rv-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 70px; color: rgb(0, 0, 0);&quot;&gt;Longterm &lt;span style=&quot;font-weight: 400;&quot;&gt;ML-DSA-44 (VK&lt;/span&gt;&lt;sub style=&quot;font-weight: 400;&quot;&gt;R&lt;/sub&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;, sk&lt;/span&gt;&lt;sub style=&quot;font-weight: 400;&quot;&gt;SIG,R&lt;/sub&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;)&lt;/span&gt;&lt;/font&gt;" vertex="1">
