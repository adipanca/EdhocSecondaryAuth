yle=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MSK = EDHOC_Exporter(PRK&lt;sub&gt;out&lt;/sub&gt;, &quot;MSK&quot;, 64)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;EMSK = EDHOC_Exporter(PRK&lt;sub&gt;out&lt;/sub&gt;, &quot;EMSK&quot;, 64)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
