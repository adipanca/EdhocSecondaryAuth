lt;/span&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;HKDF-Expand(PRK&lt;sub&gt;4e3m&lt;/sub&gt;,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;TH&lt;sub&gt;4&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px; color: light-dark(rgb(0, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Compute &lt;/span&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;AK = HKDF-Expand(PRK&lt;sub&gt;out&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px; color: light-dark(rgb(0, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Generate&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400;&quot;&gt;(Nsk&lt;sub&gt;B&lt;/sub&gt;, Npk&lt;sub&gt;B&lt;/sub&gt;) = X-WING.KeyGen()&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px; color: light-dark(rgb(0, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Set&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400;&quot;&gt; EAD&lt;sub&gt;4&lt;/sub&gt; = Npk&lt;sub&gt;B&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px; color: light-dark(rgb(0, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Update&lt;/span&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400;&quot;&gt;pk&lt;sub&gt;A&lt;/sub&gt; = EAD&lt;sub&gt;3&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px; color: light-dark(rgb(0, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;Update&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;(pk&lt;sub&gt;B&lt;/sub&gt;, sk&lt;sub&gt;B&lt;/sub&gt;) = (Npk&lt;sub&gt;B&lt;/sub&gt;, Nsk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px; color: light-dark(rgb(0, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Set &lt;/span&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;Plaintext4 = EAD&lt;sub&gt;4&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px; color: light-dark(rgb(0, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;span style=&quot;font-weight: 400; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Compute&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;nbsp;K&lt;sub&gt;4&lt;/sub&gt; =&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400;&quot;&gt;HKDF-Expand(&lt;/span&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;PRK&lt;/span&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;sub&gt;4e3m&lt;/sub&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400;&quot;&gt;, TH&lt;font style=&quot;&quo