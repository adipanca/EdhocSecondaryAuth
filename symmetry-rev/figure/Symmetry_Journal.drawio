        <mxCell id="rv-7Pt2ibclDifcsB5aAMtm-26" parent="rv-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;4. EAP Request (Message2)&lt;/font&gt;&lt;/span&gt;" vertex="1">
