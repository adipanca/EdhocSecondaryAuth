        <mxCell id="th-7Pt2ibclDifcsB5aAMtm-19" parent="th-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;1. EAP-Response/TLS&lt;br&gt;(ClientHello)&lt;/font&gt;" vertex="1">
