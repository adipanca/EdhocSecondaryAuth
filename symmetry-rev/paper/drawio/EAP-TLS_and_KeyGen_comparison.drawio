        <mxCell id="pk-7Pt2ibclDifcsB5aAMtm-17" parent="pk-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Generate&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(Nsk&lt;sub&gt;A&lt;/sub&gt;, Npk&lt;sub&gt;A&lt;/sub&gt;) = X-WING.KeyGen()&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;EAD&lt;sub&gt;1&lt;/sub&gt; = Npk&lt;sub&gt;A&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(ss&lt;sub&gt;B&lt;/sub&gt;, ct&lt;sub&gt;B&lt;/sub&gt;) = X-WING.Encaps(pk&lt;sub&gt;B&lt;/sub&gt;)&amp;nbsp;&amp;nbsp;(incl. ephemeral X25519 KeyGen)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Plaintext1 = (Method, Suites&lt;sub&gt;I&lt;/sub&gt;, ID_CRED&lt;sub&gt;I&lt;/sub&gt;, C&lt;sub&gt;I&lt;/sub&gt;, EAD&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;1&lt;/sub&gt; = H(ct&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;1e&lt;/sub&gt; = HKDF-Extract(TH&lt;sub&gt;1&lt;/sub&gt;, ss&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;1&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;1e&lt;/sub&gt;, TH&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message1 = (ct&lt;sub&gt;B&lt;/sub&gt;, AEAD.Enc(K&lt;sub&gt;1&lt;/sub&gt;, Plaintext1))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="922" width="2779.9" x="-1156.5" y="-1825.0" as="geometry" />
        </mxCell>
      <mxCell id="pk-legend" value="&lt;font style=&quot;font-size: 70px;&quot; color=&quot;#D00000&quot;&gt;&lt;b&gt;Red&lt;/b&gt; = key generation (KeyGen)&lt;/font&gt;&lt;font style=&quot;font-size: 60px;&quot;&gt;&lt;br&gt;Per run: X-WING.KeyGen = X25519 + ML-KEM-768 KeyGen (UE 1, DN-AAA 1); X-WING.Encaps contains one ephemeral X25519 KeyGen (UE 1, DN-AAA 1). Total 6 (X25519 2/2, ML-KEM-768 1/1).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="pk-7Pt2ibclDifcsB5aAMtm-1"><mxGeometry x="-1150" y="-2720" width="4600" height="220" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
