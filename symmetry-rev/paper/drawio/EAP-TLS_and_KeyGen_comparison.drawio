        <mxCell id="pk-7Pt2ibclDifcsB5aAMtm-21" parent="pk-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;fontSize=45;align=center;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;&quot;&gt;2. Access Challenge EAP Response&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;(Message1)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="1877.5" x="1640" y="-903.0" as="geometry" />
        </mxCell>
        <mxCell id="pk-7Pt2ibclDifcsB5aAMtm-22" parent="pk-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(ct&lt;sub&gt;B&lt;/sub&gt;, Ciphertext1) = Message1&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ss&lt;sub&gt;B&lt;/sub&gt; = X-WING.Decaps(ct&lt;sub&gt;B&lt;/sub&gt;, sk&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;1&lt;/sub&gt; = H(ct&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;1e&lt;/sub&gt; = HKDF-Extract(TH&lt;sub&gt;1&lt;/sub&gt;, ss&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;1&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;1e&lt;/sub&gt;, TH&lt;sub&gt;1&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(Method, Suites&lt;sub&gt;I&lt;/sub&gt;, ID_CRED&lt;sub&gt;I&lt;/sub&gt;, C&lt;sub&gt;I&lt;/sub&gt;, EAD&lt;sub&gt;1&lt;/sub&gt;) = AEAD.Dec(K&lt;sub&gt;1&lt;/sub&gt;, Ciphertext1)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(pk&lt;sub&gt;A&lt;/sub&gt;, VK&lt;sub&gt;I&lt;/sub&gt;) = Lookup(ID_CRED&lt;sub&gt;I&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Generate&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(Nsk&lt;sub&gt;B&lt;/sub&gt;, Npk&lt;sub&gt;B&lt;/sub&gt;) = X-WING.KeyGen()&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;EAD&lt;sub&gt;2&lt;/sub&gt; = Npk&lt;sub&gt;B&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(ss&lt;sub&gt;A&lt;/sub&gt;, ct&lt;sub&gt;A&lt;/sub&gt;) = X-WING.Encaps(pk&lt;sub&gt;A&lt;/sub&gt;)&amp;nbsp;&amp;nbsp;(incl. ephemeral X25519 KeyGen)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;2&lt;/sub&gt; = H(H(Message1), ct&lt;sub&gt;A&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;2e&lt;/sub&gt; = HKDF-Extract(TH&lt;sub&gt;2&lt;/sub&gt;, ss&lt;sub&gt;A&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;2&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;2e&lt;/sub&gt;, TH&lt;sub&gt;2&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;PRK&lt;sub&gt;3e2m&lt;/sub&gt; = HKDF-Extract(PRK&lt;sub&gt;2e&lt;/sub&gt;, ss&lt;sub&gt;B&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MAC&lt;sub&gt;2&lt;/sub&gt; = HKDF-Expand(PRK&lt;sub&gt;3e2m&lt;/sub&gt;, TH&lt;sub&gt;2&lt;/sub&gt;, ID_CRED&lt;sub&gt;R&lt;/sub&gt;, EAD&lt;sub&gt;2&lt;/sub&gt;, Len&lt;sub&gt;2&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Sign&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;σ&lt;sub&gt;R&lt;/sub&gt; = ML-DSA.Sign(sk&lt;sub&gt;SIG,R&lt;/sub&gt;, TH&lt;sub&gt;2&lt;/sub&gt; ‖ ID_CRED&lt;sub&gt;R&lt;/sub&gt; ‖ MAC&lt;sub&gt;2&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Plaintext2 = (C&lt;sub&gt;R&lt;/sub&gt;, ID_CRED&lt;sub&gt;R&lt;/sub&gt;, VK&lt;sub&gt;R&lt;/sub&gt;, EAD&lt;sub&gt;2&lt;/sub&gt;, MAC&lt;sub&gt;2&lt;/sub&gt;, σ&lt;sub&gt;R&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message2 = (ct&lt;sub&gt;A&lt;/sub&gt;, AEAD.Enc(K&lt;sub&gt;2&lt;/sub&gt;, Plaintext2))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;TH&lt;sub&gt;3&lt;/sub&gt; = H(TH&lt;sub&gt;2&lt;/sub&gt;, Plaintext2)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="2066" width="2779.9" x="2160.5" y="-768.0" as="geometry" />
        </mxCell>
