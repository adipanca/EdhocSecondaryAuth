          </mxGeometry>
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-26" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;4. EAP-Request/TLS&lt;br&gt;(ServerHello, …, Finished)&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="910" x="130" y="383.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-28" edge="1" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="endArrow=classic;html=1;rounded=0;fontColor=#FFFFFF;strokeWidth=6;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-205" y="2329.0" as="sourcePoint" />
            <mxPoint x="1255" y="2329.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-29" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;5. EAP-Response/TLS&lt;br&gt;(Cert, CertVerify, Finished)&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="950" x="210" y="2129.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-27" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(pk&lt;sub&gt;S&lt;/sub&gt;) = ServerHello.key_share&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ss&lt;sub&gt;X&lt;/sub&gt; = X25519(sk&lt;sub&gt;C&lt;/sub&gt;, pk&lt;sub&gt;S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Z = ss&lt;sub&gt;X&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;HS = HKDF-Extract(Derive-Secret(ES, &quot;derived&quot;), Z)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(K&lt;sub&gt;hs,C&lt;/sub&gt;, K&lt;sub&gt;hs,S&lt;/sub&gt;) = Derive-Secret(HS, &quot;c/s hs traffic&quot;, CH‖SH)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(EE, CertReq, Cert&lt;sub&gt;S&lt;/sub&gt;, CV&lt;sub&gt;S&lt;/sub&gt;, Fin&lt;sub&gt;S&lt;/sub&gt;) = AEAD.Dec(K&lt;sub&gt;hs,S&lt;/sub&gt;, …)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Ed25519.Verify(VK&lt;sub&gt;CA&lt;/sub&gt;, cert&lt;sub&gt;S&lt;/sub&gt;)  (certificate)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Ed25519.Verify(VK&lt;sub&gt;S&lt;/sub&gt;, ctx&lt;sub&gt;S&lt;/sub&gt; ‖ H(CH … Cert&lt;sub&gt;S&lt;/sub&gt;), CV&lt;sub&gt;S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Fin&lt;sub&gt;S&lt;/sub&gt; = HMAC(fk&lt;sub&gt;S&lt;/sub&gt;, H(CH … CV&lt;sub&gt;S&lt;/sub&gt;))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Sign&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;CV&lt;sub&gt;C&lt;/sub&gt; = Ed25519.Sign(sk&lt;sub&gt;SIG,C&lt;/sub&gt;, ctx&lt;sub&gt;C&lt;/sub&gt; ‖ H(CH … Cert&lt;sub&gt;C&lt;/sub&gt;))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Fin&lt;sub&gt;C&lt;/sub&gt; = HMAC(fk&lt;sub&gt;C&lt;/sub&gt;, H(CH … CV&lt;sub&gt;C&lt;/sub&gt;))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message = AEAD.Enc(K&lt;sub&gt;hs,C&lt;/sub&gt;, Cert&lt;sub&gt;C&lt;/sub&gt; ‖ CV&lt;sub&gt;C&lt;/sub&gt; ‖ Fin&lt;sub&gt;C&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Erase&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;sk&lt;sub&gt;C&lt;/sub&gt;  (forward secrecy)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1442" width="2723.5" x="-1340.0" y="627.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-30" edge="1" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="endArrow=classic;html=1;rounded=0;fontColor=#FFFFFF;strokeWidth=6;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1270" y="2329.0" as="sourcePoint" />
            <mxPoint x="3450" y="2329.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-31" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;6. Access-Request&lt;br&gt;(Cert, CertVerify, Finished)&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="970" x="2150" y="2129.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-32" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(Cert&lt;sub&gt;C&lt;/sub&gt;, CV&lt;sub&gt;C&lt;/sub&gt;, Fin&lt;sub&gt;C&lt;/sub&gt;) = AEAD.Dec(K&lt;sub&gt;hs,C&lt;/sub&gt;, …)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Ed25519.Verify(VK&lt;sub&gt;CA&lt;/sub&gt;, cert&lt;sub&gt;C&lt;/sub&gt;)  (certificate)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Ed25519.Verify(VK&lt;sub&gt;C&lt;/sub&gt;, ctx&lt;sub&gt;C&lt;/sub&gt; ‖ H(CH … Cert&lt;sub&gt;C&lt;/sub&gt;), CV&lt;sub&gt;C&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Fin&lt;sub&gt;C&lt;/sub&gt; = HMAC(fk&lt;sub&gt;C&lt;/sub&gt;, H(CH … CV&lt;sub&gt;C&lt;/sub&gt;))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MS = HKDF-Extract(Derive-Secret(HS, &quot;derived&quot;), 0)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;ap,S&lt;/sub&gt; = Derive-Secret(MS, &quot;s ap traffic&quot;, CH … Fin&lt;sub&gt;S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;EMS = Derive-Secret(MS, &quot;exp master&quot;, CH … Fin&lt;sub&gt;S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Commitment = AEAD.Enc(K&lt;sub&gt;ap,S&lt;/sub&gt;, 0x00)  (RFC 9190 §2.5)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MSK ‖ EMSK = TLS-Exporter(EMS, &quot;EXPORTER_EAP_TLS_Key_Material&quot;, 0x0D, 128)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Erase&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;sk&lt;sub&gt;S&lt;/sub&gt;  (forward secrecy)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1130" width="3427.6" x="2160.5" y="2373.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-33" edge="1" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="endArrow=classic;html=1;rounded=0;fontColor=#FFFFFF;strokeWidth=6;" value="">
