        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-21" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;2. Access-Request: EAP-Response/TLS&lt;br&gt;(ClientHello)&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="1877.5" x="1640" y="-1155.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-22" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Parse&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(pk&lt;sub&gt;C&lt;/sub&gt;) = ClientHello.key_share&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Generate&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(sk&lt;sub&gt;S&lt;/sub&gt;, pk&lt;sub&gt;S&lt;/sub&gt;) = X25519.KeyGen()  (ephemeral)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ss&lt;sub&gt;X&lt;/sub&gt; = X25519(sk&lt;sub&gt;S&lt;/sub&gt;, pk&lt;sub&gt;C&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Z = ss&lt;sub&gt;X&lt;/sub&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ServerHello = (r&lt;sub&gt;S&lt;/sub&gt;, suite, key_share = pk&lt;sub&gt;S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;HS = HKDF-Extract(Derive-Secret(ES, &quot;derived&quot;), Z)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(K&lt;sub&gt;hs,C&lt;/sub&gt;, K&lt;sub&gt;hs,S&lt;/sub&gt;) = Derive-Secret(HS, &quot;c/s hs traffic&quot;, CH‖SH)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Cert&lt;sub&gt;S&lt;/sub&gt; = cert&lt;sub&gt;S&lt;/sub&gt; (VK&lt;sub&gt;S&lt;/sub&gt;, signed by CA)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Sign&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;CV&lt;sub&gt;S&lt;/sub&gt; = Ed25519.Sign(sk&lt;sub&gt;SIG,S&lt;/sub&gt;, ctx&lt;sub&gt;S&lt;/sub&gt; ‖ H(CH … Cert&lt;sub&gt;S&lt;/sub&gt;))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Fin&lt;sub&gt;S&lt;/sub&gt; = HMAC(fk&lt;sub&gt;S&lt;/sub&gt;, H(CH … CV&lt;sub&gt;S&lt;/sub&gt;))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;Message = SH ‖ AEAD.Enc(K&lt;sub&gt;hs,S&lt;/sub&gt;, EE ‖ CertReq ‖ Cert&lt;sub&gt;S&lt;/sub&gt; ‖ CV&lt;sub&gt;S&lt;/sub&gt; ‖ Fin&lt;sub&gt;S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1234" width="2681.0" x="2160.5" y="-911.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-23" edge="1" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="endArrow=classic;html=1;rounded=0;fontColor=#FFFFFF;strokeWidth=6;" value="">
