        <mxCell id="th-7Pt2ibclDifcsB5aAMtm-35" parent="th-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;7. Commitment 0x00, then&lt;br&gt;Access-Accept (EAP-Success, MSK)&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="1150" x="1640" y="3875.0" as="geometry" />
        </mxCell>
        <mxCell id="th-7Pt2ibclDifcsB5aAMtm-36" parent="th-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;8. Commitment 0x00, then&lt;br&gt;EAP-Success&lt;/font&gt;" vertex="1">
