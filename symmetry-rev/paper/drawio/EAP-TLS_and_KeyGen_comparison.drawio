        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-36" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;8. Commitment 0x00, then&lt;br&gt;EAP-Success&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="1170" x="20" y="3563.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-38" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MS = HKDF-Extract(Derive-Secret(HS, &quot;derived&quot;), 0)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;K&lt;sub&gt;ap,S&lt;/sub&gt;, EMS = Derive-Secret(MS, …, CH … Fin&lt;sub&gt;S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Verify&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;0x00 = AEAD.Dec(K&lt;sub&gt;ap,S&lt;/sub&gt;, Commitment)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;MSK ‖ EMSK = TLS-Exporter(EMS, &quot;EXPORTER_EAP_TLS_Key_Material&quot;, 0x0D, 128)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="506" width="3427.6" x="-1141.5" y="3807.0" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-43" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;Longterm&lt;/b&gt; &lt;span style=&quot;font-weight: normal;&quot;&gt;Ed25519 cert&lt;sub&gt;S&lt;/sub&gt; (VK&lt;sub&gt;S&lt;/sub&gt;, sk&lt;sub&gt;SIG,S&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1395.3" x="2990" y="-2044" as="geometry" />
        </mxCell>
        <mxCell id="tc-z8yuo7Fk02-dqpElgXCn-1" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;Trusted&lt;/b&gt; &lt;span style=&quot;font-weight: normal;&quot;&gt;CA key VK&lt;sub&gt;CA&lt;/sub&gt; (Ed25519)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1260.0" x="-760" y="-1943" as="geometry" />
        </mxCell>
        <mxCell id="tc-z8yuo7Fk02-dqpElgXCn-2" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;Trusted&lt;/b&gt; &lt;span style=&quot;font-weight: normal;&quot;&gt;CA key VK&lt;sub&gt;CA&lt;/sub&gt; (Ed25519)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1370.0" x="2780" y="-1943" as="geometry" />
        </mxCell>
        <mxCell id="tc-7Pt2ibclDifcsB5aAMtm-17" parent="tc-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Generate&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(sk&lt;sub&gt;C&lt;/sub&gt;, pk&lt;sub&gt;C&lt;/sub&gt;) = X25519.KeyGen()  (ephemeral)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;r&lt;sub&gt;C&lt;/sub&gt; = random(32)  (nonce)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;key_share = (x25519, pk&lt;sub&gt;C&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ClientHello = (r&lt;sub&gt;C&lt;/sub&gt;, suites, groups, sig_algs = Ed25519, key_share)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ES = HKDF-Extract(0, 0)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="610" width="2461.1" x="-1156.5" y="-1825.0" as="geometry" />
        </mxCell>
      <mxCell id="tc-legend" value="&lt;font style=&quot;font-size: 70px;&quot; color=&quot;#D00000&quot;&gt;&lt;b&gt;Red&lt;/b&gt; = key generation (KeyGen)&lt;/font&gt;&lt;font style=&quot;font-size: 60px;&quot;&gt;&lt;br&gt;Per run: X25519 KeyGen at UE 1, DN-AAA 1. Total 2 (X25519 1/1).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="tc-7Pt2ibclDifcsB5aAMtm-1"><mxGeometry x="-1150" y="-2720" width="4600" height="220" as="geometry" /></mxCell></root>
