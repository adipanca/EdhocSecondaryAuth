        <mxCell id="th-7Pt2ibclDifcsB5aAMtm-16" parent="th-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;Longterm&lt;/b&gt; &lt;span style=&quot;font-weight: normal;&quot;&gt;ML-DSA-44 cert&lt;sub&gt;C&lt;/sub&gt; (VK&lt;sub&gt;C&lt;/sub&gt;, sk&lt;sub&gt;SIG,C&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1481.1" x="-630" y="-2042" as="geometry" />
        </mxCell>
        <mxCell id="th-7Pt2ibclDifcsB5aAMtm-18" edge="1" parent="th-7Pt2ibclDifcsB5aAMtm-1" style="endArrow=classic;html=1;rounded=0;fontColor=#FFFFFF;strokeWidth=6;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
