        <mxCell id="th-7Pt2ibclDifcsB5aAMtm-17" parent="th-7Pt2ibclDifcsB5aAMtm-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingTop=10;" value="&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Generate&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(sk&lt;sub&gt;C&lt;/sub&gt;, pk&lt;sub&gt;C&lt;/sub&gt;) = X25519.KeyGen()  (ephemeral)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot; color=&quot;#D00000&quot;&gt;&amp;nbsp;Generate&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;(dk&lt;sub&gt;PQ&lt;/sub&gt;, ek&lt;sub&gt;PQ&lt;/sub&gt;) = ML-KEM-768.KeyGen()  (ephemeral)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;r&lt;sub&gt;C&lt;/sub&gt; = random(32)  (nonce)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;key_share = (X25519MLKEM768, ek&lt;sub&gt;PQ&lt;/sub&gt; ‖ pk&lt;sub&gt;C&lt;/sub&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Set&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ClientHello = (r&lt;sub&gt;C&lt;/sub&gt;, suites, groups, sig_algs = ML-DSA-44, key_share)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 75px;&quot;&gt;&amp;nbsp;Compute&amp;nbsp;&lt;span style=&quot;font-weight: normal;&quot;&gt;ES = HKDF-Extract(0, 0)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
