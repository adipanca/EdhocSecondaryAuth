        <mxCell id="th-7Pt2ibclDifcsB5aAMtm-34" edge="1" parent="th-7Pt2ibclDifcsB5aAMtm-1" style="endArrow=classic;html=1;rounded=0;fontColor=#FFFFFF;strokeWidth=6;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1247" y="4075.0" as="sourcePoint" />
            <mxPoint x="-213" y="4075.0" as="targetPoint" />
